server {
    listen __PUBLIC_PORT__;
    listen [::]:__PUBLIC_PORT__;
    server_name __PUBLIC_HOST__;

    include /etc/nginx/hub-log-mode/hub-portal.conf;
    include /etc/nginx/snippets/hub-security-headers.conf;
    client_max_body_size 20m;

    location /static/ {
        alias /opt/hub-portal/current/staticfiles/;
        access_log off;
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location / {
        proxy_pass http://hub_portal_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 300s;
    }
}
