[Unit]
Description=HUB Portal Gunicorn
After=network.target mariadb.service
Requires=mariadb.service

[Service]
Type=simple
User=hubportal
Group=www-data
WorkingDirectory=/opt/hub-portal/current
Environment=HUB_PORTAL_GUNICORN_WORKERS=2
EnvironmentFile=/etc/hub-portal/hub-portal.env
ExecStart=/opt/hub-portal/venv/bin/gunicorn \
    --workers ${HUB_PORTAL_GUNICORN_WORKERS} \
    --bind unix:/run/hub-portal/hub-portal.sock \
    --error-logfile - \
    hub_portal.wsgi:application
RuntimeDirectory=hub-portal
RuntimeDirectoryMode=0755
Restart=always
RestartSec=5
UMask=0027

[Install]
WantedBy=multi-user.target
