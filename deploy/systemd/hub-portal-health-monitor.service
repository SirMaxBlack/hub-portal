[Unit]
Description=HUB Portal service health monitor
After=network-online.target mariadb.service hub-portal.service
Wants=network-online.target
Requires=mariadb.service

[Service]
Type=simple
User=hubportal
Group=www-data
WorkingDirectory=/opt/hub-portal/current
EnvironmentFile=/etc/hub-portal/hub-portal.env
ExecStart=/opt/hub-portal/venv/bin/python manage.py monitor_service_health --sleep 5
Restart=always
RestartSec=5
UMask=0027

[Install]
WantedBy=multi-user.target
