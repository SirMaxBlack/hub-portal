# Этот файл служит схемой. Установщик создаёт рабочий env автоматически.
HUB_PORTAL_SECRET_KEY=CHANGE_ME
HUB_PORTAL_TOKEN_ENCRYPTION_KEY=CHANGE_ME
HUB_PORTAL_INTERNAL_AUTH_KEY=CHANGE_ME

HUB_PORTAL_PUBLIC_HOST=hub.example.com
HUB_PORTAL_PUBLIC_SCHEME=https
HUB_PORTAL_PUBLIC_URL=https://hub.example.com
HUB_PORTAL_SERVICE_DOMAIN_SUFFIX=.hub.example.com
HUB_PORTAL_ALLOWED_HOSTS=hub.example.com,.hub.example.com,127.0.0.1,localhost
HUB_PORTAL_CSRF_TRUSTED_ORIGINS=https://hub.example.com,https://*.hub.example.com
HUB_PORTAL_SESSION_COOKIE_DOMAIN=.hub.example.com

HUB_PORTAL_DB_NAME=hub_portal
HUB_PORTAL_DB_USER=hub_portal
HUB_PORTAL_DB_PASSWORD=CHANGE_ME
HUB_PORTAL_DB_HOST=127.0.0.1
HUB_PORTAL_DB_PORT=3306
HUB_PORTAL_DB_CONN_MAX_AGE=120

HUB_PORTAL_DEBUG=0
HUB_PORTAL_SESSION_COOKIE_SECURE=1
HUB_PORTAL_CSRF_COOKIE_SECURE=1
HUB_PORTAL_SECURE_SSL_REDIRECT=1
HUB_PORTAL_SECURE_HSTS_SECONDS=31536000
HUB_PORTAL_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
HUB_PORTAL_SECURE_HSTS_PRELOAD=0
HUB_PORTAL_TIME_ZONE=UTC
HUB_PORTAL_AUDIT_RETENTION_DAYS=180
HUB_PORTAL_GUNICORN_WORKERS=2
HUB_PORTAL_CERTBOT_EMAIL=

HUB_PORTAL_SERVICE_ADMIN_HELPER=/usr/local/bin/hub-portal-service-admin
HUB_PORTAL_SERVICE_ADMIN_RUNTIME_DIR=/opt/hub-portal/runtime/service-admin
HUB_PORTAL_LOGIN_PROTECTION_RUNTIME_DIR=/opt/hub-portal/runtime/login-protection
HUB_PORTAL_ACCESS_RULE_MARKER_FILE=/opt/hub-portal/runtime/portal-access-rules.stamp
HUB_PORTAL_SERVICE_SITE_AVAILABLE_DIR=/etc/nginx/sites-available
HUB_PORTAL_SERVICE_SITE_ENABLED_DIR=/etc/nginx/sites-enabled
